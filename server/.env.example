# --- Agnes (OpenAI-compatible, free/local-first) ---
# Token lives in ~/.config/agnes/token; copy it here or export in your shell.
AGNES_API_KEY=your_agnes_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash

# Image generation model (T2I + I2I)
PORTRAIT_MODEL=agnes-image-2.5-flash
AGNES_IMAGE_SIZE=2K

# Video generation model (I2V)
KLING_MODEL=agnes-video-2.5-flash
AGNES_VIDEO_SIZE=720P
